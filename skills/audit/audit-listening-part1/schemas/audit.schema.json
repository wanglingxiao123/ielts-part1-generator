{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "audit.schema.json",
  "title": "IELTS Listening Part 1 Audit Result",
  "description": "Structured quality assessment. Native output of the audit skill; the human-readable Markdown report is a rendering of this document, not the source. blind_information_map MUST be built by reading the script only, without the generator's blueprint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "assessable",
    "score",
    "findings",
    "blind_information_map",
    "metrics"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "PASS",
        "PASS_WITH_MINOR_EDITS",
        "FAIL",
        "NOT_ASSESSABLE"
      ],
      "description": "Underscore form for programmatic handling; rendered with spaces in the Markdown report. FAIL is a usable-but-flawed material and is delivered with its findings; NOT_ASSESSABLE means no usable script was found, and the orchestrator re-runs that slot rather than delivering it."
    },
    "assessable": {
      "type": "boolean"
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "dimensions"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Severity caps apply: any critical finding caps at 49, any major finding caps at 69."
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scenario_purpose_frame",
            "information_map_quality",
            "role_consistency",
            "naturalness_level",
            "difficulty_distractor_control",
            "transcript_readiness"
          ],
          "properties": {
            "scenario_purpose_frame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "information_map_quality": {
              "type": "integer",
              "minimum": 0,
              "maximum": 25
            },
            "role_consistency": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            "naturalness_level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "difficulty_distractor_control": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "transcript_readiness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "rule",
          "evidence",
          "fix"
        ],
        "properties": {
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "rule": {
            "type": "string",
            "minLength": 1,
            "description": "The violated requirement."
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "description": "Shortest sufficient quote."
          },
          "turn_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Where the defect sits; null for whole-script findings."
          },
          "fix": {
            "type": "string",
            "minLength": 1,
            "description": "Smallest concrete correction."
          }
        }
      }
    },
    "blind_information_map": {
      "type": "array",
      "description": "Recordable details found by reading the script blind, in first-occurrence order. Compared against the blueprint by cross_check.py: points the auditor could not recover are genuine defects.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "type",
          "evidence",
          "turn_index",
          "speaker",
          "clarity"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "enum": [
              "name",
              "number",
              "address",
              "price",
              "datetime",
              "quantity",
              "condition",
              "option"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "turn_index": {
            "type": "integer",
            "minimum": 0
          },
          "speaker": {
            "enum": [
              "speaker2",
              "speaker3"
            ]
          },
          "clarity": {
            "enum": [
              "clear",
              "confirmed",
              "corrected",
              "indirect",
              "ambiguous"
            ]
          },
          "mechanism": {
            "type": [
              "string",
              "null"
            ],
            "description": "Spelling, correction, distractor, or confirmation mechanism if present."
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dialogue_words",
        "dialogue_turns",
        "first_half_turns",
        "second_half_turns",
        "narrator_words"
      ],
      "properties": {
        "dialogue_words": {
          "type": "integer",
          "minimum": 0
        },
        "dialogue_turns": {
          "type": "integer",
          "minimum": 0
        },
        "first_half_turns": {
          "type": "integer",
          "minimum": 0
        },
        "second_half_turns": {
          "type": "integer",
          "minimum": 0
        },
        "narrator_words": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Non-blocking observations, e.g. word count outside the typical 600-650 band while inside the hard 450-750 limit. Advisory input to the revise step; never a failure signal."
    },
    "compliance_review": {
      "type": "object",
      "description": "Specification-compliance pass: the semantic items no script can check (C1-C6 in audit-rubric.md). Separate from `findings` because these are the items the generator revises against, while `findings` also carries script-derived results. Optional so an audit of an unassessable artifact stays valid.",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "description": "One entry per checklist item reviewed, compliant or not.",
          "items": {
            "type": "object",
            "required": [
              "code",
              "compliant"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "C1",
                  "C2",
                  "C3",
                  "C4",
                  "C5",
                  "C6"
                ],
                "description": "Checklist item in audit-rubric.md."
              },
              "compliant": {
                "type": "boolean"
              },
              "severity": {
                "enum": [
                  "critical",
                  "major",
                  "minor"
                ]
              },
              "turn_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "description": "null for a finding about the script as a whole."
              },
              "evidence": {
                "type": "string",
                "description": "Shortest sufficient quote from the script."
              },
              "fix": {
                "type": "string",
                "description": "Concrete, minimal, actionable. 'Consider improving the pacing' is not a fix; 'split turn 12 into two exchanges' is."
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "description": "One or two sentences on the overall compliance picture."
        }
      }
    }
  }
}
